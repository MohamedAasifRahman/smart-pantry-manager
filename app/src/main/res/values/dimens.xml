<?xml version="1.0" encoding="utf-8"?>
<!--
    One spacing scale and one type scale for the whole app.
    Layouts reference these instead of hard-coding "16dp" in twenty places.
-->
<resources>

    <!-- Spacing scale -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- Shape -->
    <dimen name="corner_radius_card">16dp</dimen>
    <dimen name="corner_radius_small">12dp</dimen>
    <dimen name="card_elevation">2dp</dimen>

    <!-- Type scale -->
    <dimen name="text_headline">22sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>

    <!-- Components -->
    <dimen name="icon_size_small">20dp</dimen>
    <dimen name="icon_size_medium">24dp</dimen>
    <dimen name="icon_size_empty_state">96dp</dimen>
    <dimen name="touch_target">40dp</dimen>
    <dimen name="list_bottom_padding">88dp</dimen>

</resources>
